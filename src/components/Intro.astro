---
import type { Lang } from "@/i18n/config";
import { t } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<!-- Local intro (SEO copy) right under the hero. Styled after the removed
     About section: centered, orange mono heading, gray mono body. -->
<section id="intro" class="py-20 bg-black">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2
        class="text-4xl md:text-5xl font-bold font-space-mono-bold text-[#ff8d2f] mb-8"
      >
        {t(lang, "introTitle")}
      </h2>
      <p
        class="text-lg md:text-xl text-gray-300 font-space-mono-regular leading-relaxed"
      >
        {t(lang, "introText")}
      </p>
    </div>
  </div>
</section>
